        "import cv2\n",
        "cv2.__version__"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "img=cv2.imread('/content/drive/MyDrive/AI/V.jpg')\n",
        "gray_image=cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)\n",
        "edges=cv2.Canny(gray_image,70,400)\n",
        "from google.colab.patches import cv2_imshow\n",
        "cv2_imshow(img)\n",
        "cv2_imshow(edges)"
      ],
